# Copy to .env.local. The app builds and runs on mock data with none of these set.

# Data source: "mock" (default) or "db". The database is used only when this is "db".
# A database deployment needs Clerk keys: on Vercel the app refuses to start without them.
DATA_SOURCE=mock

# Neon Postgres (pooled string for the app, unpooled for migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk. Sign-in is active only with both keys AND DATA_SOURCE=db; otherwise every
# visitor is the sample user. The signing secret is only needed once a webhook endpoint exists.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bunny Stream (Milestone 4)
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_TOKEN_SECURITY_KEY=
BUNNY_PULL_ZONE_HOST=

# Help contacts shown in "Need help?" (international format, digits only for WhatsApp)
NEXT_PUBLIC_HELP_PHONE=
NEXT_PUBLIC_HELP_WHATSAPP=

CRON_SECRET=
