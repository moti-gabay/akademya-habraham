# Copy to .env.local. The app builds and runs on mock data with none of these set.

# Data source: "mock" (default) or "db". The database is used only when this is "db".
# A database deployment needs Clerk keys: on Vercel the app refuses to start without them.
DATA_SOURCE=mock

# Local only: "admin" makes the sample visitor an admin, so the admin screens work with
# no keys. Mock data only: ignored with DATA_SOURCE=db, when Clerk is active, on Vercel,
# and in production builds.
MOCK_ROLE=

# Neon Postgres (pooled string for the app, unpooled for migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk. Sign-in is active only with both keys AND DATA_SOURCE=db; otherwise every
# visitor is the sample user. The signing secret is only needed once a webhook endpoint exists.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Media. Both are opt-in: with anything else the app uses in-memory fakes and needs no
# account. "bunny" needs the Bunny variables below, "r2" the R2 ones.
MEDIA_PROVIDER=
FILE_STORAGE=
# How long the fake video "encoding" takes, in ms. Unset means a few seconds; e2e sets it short.
FAKE_MEDIA_PROCESSING_MS=

# Bunny Stream (video upload, encoding status, captions). The token security key is for
# signed playback in Milestone 4. The webhook secret is a random string that becomes
# part of the webhook address: /api/webhooks/bunny/<secret>
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_PULL_ZONE_HOST=
BUNNY_WEBHOOK_SECRET=
BUNNY_TOKEN_SECURITY_KEY=

# Cloudflare R2 (caption masters and thumbnails). R2_PUBLIC_URL is the bucket's public
# address; only thumbnails are read through it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Help contacts shown in "Need help?" (international format, digits only for WhatsApp)
NEXT_PUBLIC_HELP_PHONE=
NEXT_PUBLIC_HELP_WHATSAPP=

CRON_SECRET=
